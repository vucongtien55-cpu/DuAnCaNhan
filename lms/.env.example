# Sao chép thành .env (đã được .gitignore) rồi điền giá trị thật. KHÔNG commit .env.
LMS_DB_URL=jdbc:postgresql://localhost:5432/lms
LMS_DB_USERNAME=postgres
LMS_DB_PASSWORD=
# Tối thiểu 32 byte ngẫu nhiên; để trống thì dùng khóa tạm theo mỗi lần khởi động
LMS_JWT_SECRET=
LMS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Admin đầu tiên (chỉ tạo khi cả hai được đặt và chưa có Admin nào)
LMS_ADMIN_USERNAME=
LMS_ADMIN_PASSWORD=
LMS_ADMIN_EMAIL=
LMS_UPLOAD_DIR=./uploads

# Bật Swagger UI (/swagger-ui.html) khi phát triển; để false khi triển khai
LMS_DOCS_ENABLED=false
