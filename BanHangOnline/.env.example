# Copy these values into your shell or deployment secret manager.
# Do not commit a real .env file with production credentials.

DB_URL=jdbc:postgresql://localhost:5432/marketplace_db
DB_USERNAME=postgres
DB_PASSWORD=

# Must be Base64 and decode to at least 32 bytes.
JWT_SECRET_BASE64=

# Optional password recovery email settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=

FRONTEND_BASE_URL=http://localhost:8080
